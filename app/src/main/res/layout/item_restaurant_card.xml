<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_flip_container"
    android:layout_width="match_parent"
    android:layout_height="220dp"
    android:layout_margin="8dp"
    android:elevation="6dp">

    <LinearLayout
        android:id="@+id/card_front"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/resto_general_card"
        android:backgroundTint="#FEF1D7"
        android:backgroundTintMode="src_in"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/front_logo"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/front_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/card_back"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/resto_general_card"
        android:backgroundTint="#FEF1D7"
        android:backgroundTintMode="src_in"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/back_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/back_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E67E22"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/back_details"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:textColor="#333333"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/back_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#666666"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>